# OpenCode Cowork V2 — example environment file.
# Copy to .env and adjust. Never commit real credentials.

# Network
COWORK_HOST=127.0.0.1
COWORK_PORT=4319

# Data directory (SQLite database, auth token, logs)
# COWORK_DATA_DIR=/home/you/.local/share/cowork

# Explicit OpenCode server. When unset, Cowork discovers or starts the
# shared local OpenCode background service via @opencode/client.
# COWORK_OPENCODE_URL=http://127.0.0.1:4096
# COWORK_OPENCODE_TOKEN=

# Directory containing the built web application
# COWORK_WEB_DIR=/opt/cowork/apps/web/dist

# Optional comma-separated allow-list of additional workspace roots.
# Workspaces are always registered explicitly through the UI/API.
# COWORK_ALLOWED_WORKSPACE_ROOTS=/home/you/work,/srv/projects

# Override the generated local API token (development only)
# COWORK_AUTH_TOKEN=replace-with-a-random-token

# Resource limits
COWORK_MAX_PROMPT_CHARS=20000
COWORK_MAX_FILES=5000
COWORK_MAX_RESPONSE_BYTES=1048576

# Set to 1 only when a trusted reverse proxy terminates authentication
# COWORK_TRUST_PROXY=0

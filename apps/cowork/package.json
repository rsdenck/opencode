{
  "name": "opencode-cowork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode Cowork V2 \u2014 workspace-oriented autonomous agent workbench built on OpenCode.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "npm run dev --workspace @cowork/web",
    "build": "npm run build --workspace @cowork/web && tsup",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run packages apps/server --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rm -rf apps/server/dist apps/web/dist packages/*/dist coverage",
    "build:server": "tsup"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
